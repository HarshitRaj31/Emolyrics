# ==============================================================================
# EmoLyrics Frontend (Vite + React) - Environment Configuration
# ==============================================================================

# API Backend Base URL
# Development (Vite dev server with local proxy): Leave empty or set to /api
# Production (Docker with Nginx reverse proxy): Leave empty or set to /api
# Production (Independent PaaS like Vercel/Netlify): Set to full backend URL, e.g. https://api.emolyrics.app/api
VITE_API_URL=
