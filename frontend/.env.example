# ==============================================================================
# EmoLyrics Frontend (Vite + React) - Environment Configuration
# ==============================================================================

# API Backend Base URL
# Development (Vite dev server with local proxy to http://localhost:5000): Leave empty or set to /api
# Production (Docker with Nginx reverse proxy): Set to /api
# Production (Vercel / Cloudflare Pages): Set to deployed backend API URL (e.g. https://emolyrics-il28.vercel.app/api)
# Note: Production builds default to https://emolyrics-il28.vercel.app/api when VITE_API_URL is omitted.
VITE_API_URL=
