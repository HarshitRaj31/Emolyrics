# ==============================================================================
# EmoLyrics Full-Stack Platform - Master Environment Configuration
# Copy this file to .env for multi-service or Docker Compose deployments.
# NEVER commit real credentials to version control.
# ==============================================================================

# Global Environment Mode ('development' or 'production')
NODE_ENV=production

# Exposed Host Ports
PORT=5000
FRONTEND_PORT=3000
ML_PORT=8001

# CORS Allowed Origin
# In development or single-domain: http://localhost:3000
# In production: https://emolyrics.app
CORS_ORIGIN=http://localhost:3000

# Backend Secret Key (Generate with: openssl rand -hex 32)
JWT_SECRET=replace-with-a-secure-random-32-character-secret-key-in-prod

# Database
# Local/Docker: mongodb://mongo:27017/emolyrics
# Cloud: mongodb+srv://<user>:<password>@cluster.mongodb.net/emolyrics?retryWrites=true&w=majority
# (If omitted, backend gracefully uses built-in in-memory fallback)
MONGODB_URI=mongodb://mongo:27017/emolyrics

# Python ML Microservice URL (used by backend)
# Local: http://127.0.0.1:8001
# Docker Compose: http://ml-services:8001
ML_SERVICE_URL=http://ml-services:8001

# AI Music Assistant (Ollama LLM) - Optional
# Local: http://127.0.0.1:11434
# Docker to Host: http://host.docker.internal:11434
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen2.5:3b

# ML Service Runtime Configuration
TORCH_NUM_THREADS=4
PREDICTION_CACHE_SIZE=1000
MAX_INPUT_CHARS=5000

