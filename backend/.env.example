# ==============================================================================
# EmoLyrics Backend - Environment Configuration Template
# Copy this file to .env for local Windows development.
# NEVER commit real credentials or .env files to version control!
# For Vercel deployment, configure these in Vercel Project Settings -> Environment Variables.
# ==============================================================================

# Node Environment ('development' or 'production')
NODE_ENV=development

# Local HTTP Server Port (ignored by Vercel serverless runtime)
PORT=5000

# Allowed Frontend Origins (comma-separated, no trailing slashes)
# Local dev default: http://localhost:3000,http://localhost:5173
# Production (Cloudflare Pages + custom domain + Vercel previews):
# CORS_ORIGIN=https://your-project.pages.dev,https://your-custom-domain.com
CORS_ORIGIN=http://localhost:3000,http://localhost:5173

# MongoDB Connection String
# Local Windows: mongodb://127.0.0.1:27017/emolyrics
# Vercel Production (MongoDB Atlas M0 Free):
# MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/emolyrics?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/emolyrics

# JWT Authentication Secret Key (MANDATORY in production / Vercel; 32+ random chars)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace-with-a-secure-random-32-character-secret-key-in-prod

# Separate Python FastAPI Multilingual ML Microservice URL
# Local Windows: http://127.0.0.1:8001
# Vercel Production: https://your-ml-service-host.example.com
ML_SERVICE_URL=http://127.0.0.1:8001

# Optional ML HTTP Timeouts (milliseconds)
ML_HEALTH_TIMEOUT_MS=4000
ML_REQUEST_TIMEOUT_MS=15000
ML_LINES_TIMEOUT_MS=25000

# AI Music Assistant - Optional Ollama LLM Integration
# Local Windows: http://127.0.0.1:11434
# Vercel Production: Leave unset unless pointing to an authenticated remote Ollama host.
# Localhost Ollama is unreachable from Vercel; backend returns explicit offline status + NLP fallback.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:3b

# Maximum Lyrics Text Input Length (in characters)
MAX_LYRICS_LENGTH=30000

# Rate Limiter Window (in milliseconds, default: 900000 = 15 minutes)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=30
