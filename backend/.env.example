# ==============================================================================
# EmoLyrics Production Environment Configuration Template
# Copy this file to .env and replace placeholders with secure production values.
# NEVER commit .env to version control!
# ==============================================================================

# Node Environment ('development' or 'production')
NODE_ENV=production

# Server Port
PORT=5000

# Allowed CORS Origins (e.g. 'https://emolyrics.app' or comma-separated list)
# Default is '*' which is permissive for local development
CORS_ORIGIN=*

# MongoDB Connection String (MongoDB Atlas or Local Instance)
# Example Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/emolyrics?retryWrites=true&w=majority
# If omitted, the server automatically uses high-performance memory store fallback
MONGODB_URI="mongodb://127.0.0.1:27017/emolyrics"

# JWT Authentication Secret Key (Required in production, 32+ random characters recommended)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="7f0eb9158792029d3a61891344a740c277f6e567d6320b320f7cf24c8f12bc116348c2ae1de92cf8c9f730680dda9d7ebb4f30af1042b7cce429a619e3c14ce7"

# Python ML Emotion Microservice URL
# Local development: http://127.0.0.1:8001
# Docker Compose: http://ml-services:8001
ML_SERVICE_URL=http://127.0.0.1:8001

# AI Music Assistant - Ollama Local LLM Integration (Optional)
# If offline or omitted, backend automatically applies deterministic fallback NLP
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:3b

# Maximum Lyrics Text Input Length (in characters, default: 30000)
MAX_LYRICS_LENGTH=30000

# Rate Limiter Window (in milliseconds, default: 900000 = 15 minutes)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=30
